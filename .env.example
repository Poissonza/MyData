# Environment: dev (local Docker) or prod (Databricks)
APP_ENV=dev

# Delta Lake storage path
# Dev:  file:///data/delta
# Prod: dbfs:/delta  or  abfss://<container>@<account>.dfs.core.windows.net/delta
DELTA_BASE_PATH=file:///data/delta

# Databricks (prod only)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Torn API
TORN_API_KEY=
TORN_COMMENT=python

# Relational database (TTT, legacy game analysis)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
